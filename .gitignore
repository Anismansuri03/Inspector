# ------------------------------------------------------------------------------
# Inspector v2 .gitignore
# ------------------------------------------------------------------------------

# --- .NET build artifacts ---
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa]rm/
[Aa]rm64/
bld/
*.dll
*.exe
*.pdb
*.cache
*.ilk
*.meta
*.obj
*.iobj
*.ipdb
*.log
*.tmp
*.temp
*.bak
*~
*.user
*.suo
*.userosscache
*.sln.docstates
*.rsuser

# NuGet
*.nupkg
*.snupkg
packages/
.nuget/

# Publish output
publish/

# --- Test results ---
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
coverage*.json
coverage*.xml
coverage*.info

# --- Node / website tooling (not used by the core tool) ---
node_modules/
.parcel-cache/
.pnpm-store/
dist/
build/

# --- IDE / editor state ---
.vs/
.idea/
.vscode/
*.code-workspace

# --- OS metadata ---
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# --- Inspector runtime data (machine-local, NEVER commit) ---
# Captures, generated HTML reports, snapshots, and config contain real
# process command lines, usernames, and paths from the local machine.
capture*.jsonl
report_*.html
compare_*.html
snapshot_*.json
baseline.snapshot.json
config.json
*.log
C:\ProgramData\Inspector\

# --- Secrets / local environment ---
.env
.env.*
*.pem
*.key
*.pfx
*.snk
secrets.json
appsettings.*.Local.json

# --- Misc ---
*.lnk
Archive/
